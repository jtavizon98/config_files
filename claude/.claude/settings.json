{
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(sudo)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/home/jairot/.dotfiles",
      "/home/jairot/.scripts"
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.message // \"Waiting for input\"' | { read -r m; notify-send -a \"Claude Code\" -u normal \"Claude Code\" \"$m\"; } 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-send -a \"Claude Code\" -u low -t 4000 \"Claude Code\" \"Turn complete\" 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); dir=$(echo \"$input\" | jq -r '.workspace.current_dir'); printf '\\033[1;38;5;27m|%s\\033[1;38;5;31m@%s\\033[00m \\033[1m%s\\033[00m' \"$(whoami)\" \"$(hostname -s)\" \"$(basename \"$dir\")\""
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "theme": "dark-ansi",
  "preferredNotifChannel": "terminal_bell",
  "autoContinueAtUsageLimit": false,
  "agentPushNotifEnabled": true
}
