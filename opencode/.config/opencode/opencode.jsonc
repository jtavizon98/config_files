{
  "$schema": "https://opencode.ai/config.json",

  "instructions": ["~/.config/opencode/AGENTS.md"],


  "permission": {
    "bash": {
      "sudo *": "deny"
    }
  },

  "agent": {
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "copy-reviewer": "allow",
          "vision-reader": "allow"
        }
      }
    },
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "copy-reviewer": "allow",
          "worker": "allow",
          "smart-worker": "allow",
          "vision-reader": "allow"
        }
      }
    }
  },

  "disabled_providers": ["opencode"]
}
