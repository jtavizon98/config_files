{
  "$schema": "https://opencode.ai/config.json",

  "update": "disable",

  "permissions": [
    { "action": "shell", "resource": "sudo *", "effect": "deny" }
  ],

  "agents": {
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "plan": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "subagent", "resource": "copy-reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "vision-reader", "effect": "allow" }
      ]
    },
    "build": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "subagent", "resource": "copy-reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "worker", "effect": "allow" },
        { "action": "subagent", "resource": "smart-worker", "effect": "allow" },
        { "action": "subagent", "resource": "vision-reader", "effect": "allow" }
      ]
    }
  },

  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "opencode", "effect": "deny" }
    ]
  }
}
